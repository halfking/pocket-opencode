# already covered above). backend/test-evidence holds transient probe output
# from local runs and is not part of the shipped product.
backend/gen-jwt
backend/test-evidence/

# Test evidence 鈥?only ship the deliberately-traced dated subdirs (e.g.
# 2026-09-09-list-sync-verify); ignore the rest at the root so future dated
# snapshots are auto-skipped without .gitignore churn. Already-tracked
# subdirs stay tracked because git does not un-track already-added files
# via .gitignore.
test-evidence/


# One-off local APK evidence snapshots (too large for git; keep on disk only)
docs/artifacts/

# Scratchpad for ad-hoc agent session notes (not source-of-truth docs)
tmp/

# === 2026-09-16 cross-platform-portability cleanup ===
# The repo had zero paths containing true Windows-illegal characters
# (<>:"|?*), no reserved device names (CON/PRN/AUX/NUL/COM/LPT), no
# trailing-space/dot filenames, no case collisions, and no paths near the
# 260-char MAX_PATH limit. The cleanup below targets platform-specific
# *build artifacts* and *secrets* that should never have been tracked:
# they are local-only, large, and/or sensitive, and they break clean
# cross-platform checkout because the same names are rebuilt with
# different platform binaries on Windows / macOS / Linux.

# Root-level build outputs (sources: backend/cmd/* ; not part of source)
/bin/

# Backend test binaries (sources: backend/cmd/test_acp_* ; locally built)
backend/test_acp_*

# Deploy artifacts directory (local build outputs of pocketd for offline
# image / cross-OS testing). Generic pattern catches 鏈湴鏂规/artifacts/
# and any future locale-named deploy artifacts.
/backend/deploy/*/artifacts/

# Email encryption master keys 鈥?generated per host, must NEVER be
# committed. Two copies exist due to a repo-root vs backend-root path
# duplication; both are sensitive.
backend/data/email_master.key
data/email_master.key


# Downloads (toolchain installers)
downloads/

# Local MiniMax / Mavis runtime cache (per-host skill installs; not source)
.minimax/

# Local debug log (pocketd / dev tooling run from repo root)
debug.log

# Python bytecode caches.
# 2026-10-01: deploy/bin/lib/check-databases.py 被 `python3 -c 'import ...'`
# 之类的调用顺带编译出 __pycache__/*.pyc，`git add -A` 把它一起提交了。
# 桩/工具脚本不是可交付产物，且 .pyc 跨平台不可复现。
__pycache__/
*.py[cod]

# 本地验证用的后端二进制（scripts/start-local-backend.ps1 等脚本的构建产物）。
# 它是仓库脚本**引用**的路径（backend\.verify-bin\pocketd.exe），但二进制本身不入库：
# 每个平台/架构都不同，入库只会让 git status 长期挂着未跟踪噪声，并诱导别人
# `git add -A` 把几十 MB 的可执行文件提交进去。
backend/.verify-bin/
# 2026-10-02：真机验收时并行起了第二个实例，用 .verify-bin2 避免占用
# 已经在跑的 .verify-bin 产物（那个二进制被别的会话/脚本按固定路径引用）。
# 同理，端口不同的并行实例在 .verify-bin<N>/ 下，模式一并兜住。
backend/.verify-bin*/
# 需求 6 A 路线 wasm 探针的编译产物（单个 ~4-9MB，几乎全是 Go runtime）。
# 由 scripts/wasmprobe-run.mjs 生成，用完自删；这里兜底防止手动构建时误提交。
# 注意：frontend/public/assets/*.wasm 是**前端产物**，已在上面单独处理，别一起排除。
backend/cmd/wasmprobe/*.wasm
backend/cmd/wasmprobe/*/*.wasm
backend/cmd/wasmprobe/*.native.json
backend/cmd/wasmprobe/*/*.native.json
backend/cmd/wasmprobe/*.wasm.json
backend/cmd/wasmprobe/*/*.wasm.json
backend/cmd/wasmbaseline/*.wasm

