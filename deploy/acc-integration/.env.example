# opencode-pocket — acc/memora/redclaw 集成部署 .env 模板
#
# 用法：cp .env.example .env 后按需修改。
# 所有键最终被 backend/internal/config/config.go 读取；这里只列常用项。

# ---- 端口（宿主机→容器）----
POCKET_HOST_PORT=8088
POCKET_FRONTEND_HOST_PORT=4175

# ---- JWT 签名密钥（dev 即可；prod 必须 ≥ 32 字节随机）----
POCKET_JWT_SECRET=local-pocket-jwt-secret-012345678901234567890

# ---- 自动种子 admin/admin1234（dev 用；prod 必须 POCKET_DEV_AUTH=false）----
# 注意：backend/internal/auth/users.go 要求密码 ≥ 8 字符；"admin" 会被拒，
# 留下 password_hash 为空导致登录 401。生产环境请使用更复杂密码或关闭
# POCKET_DEV_AUTH 后通过 admin UI / API 显式创建用户。
POCKET_DEV_AUTH=true
POCKET_AUTH_USER=admin
POCKET_AUTH_PASS=admin1234

# ---- 时区 / 日志 ----
POCKET_TIMEZONE_OFFSET_SEC=28800
POCKET_LOG_LEVEL=info

# ---- 跨服务调用 ----
# 这些值在 docker-compose.yml 中已经设置；这里只是 cover-doc。
# 修改实际值请改 docker-compose.yml。
#
# 当前 PG 目标：llm-gateway-pg（kx-citus-pg17-arm64-vector-fixed 镜像），
# 通过 host.docker.internal:5432 转发。cred 来自容器 POSTGRES_* env。
# 该 PG 上 kaixuan DB 已有 191 张其他模块表，pocketd 34 张表为 additive
# migration（不冲突）。
# POCKET_POSTGRES_DSN=postgresql://llm_gateway:llm_gateway_db_pass_2026_secure@host.docker.internal:5432/kaixuan?sslmode=disable
# POCKET_KXMEMORY_BASE_URL=http://kxmemory-go-local:8080    # memora/kxmemory
# POCKET_BASE_URL=http://acc-go-local:4101                   # agent-control-center
# POCKET_REDCLAW_BASE_URL=                                    # 留空：RedClaw 端点尚未提供

# ---- OpenCode 实例（dev mock；prod 应改成真实地址）----
POCKET_OPENCODE_INSTANCES=[{"id":"local-opencode","displayName":"Local OpenCode","baseURL":"http://host.docker.internal:4096","environment":"development","capabilities":["session","summary","pty"]}]

# ---- Email / Feishu / KxMemory（默认关；按需启用）----
POCKET_EMAIL_FETCH_ENABLED=false
POCKET_FEISHU_APP_ID=
POCKET_FEISHU_APP_SECRET=
POCKET_KXMEMORY_BASE_URL=

# ---- CORS ----
POCKET_ALLOWED_ORIGINS=http://localhost:4175,http://127.0.0.1:4175

# ---- Vite 前端 build 期 API base ----
# 这一行给 frontend build 用（Dockerfile.frontend 会 RUN npm run build，
# 此时 NODE_ENV=production 时加载 .env.production）。本集成走 `ios-dev`
# profile（指向 192.168.31.37:8088）。若 frontend 也要走同源 nginx
# 反代（推荐，容器内 BACKEND_UPSTREAM=http://pocketd:8088），则
# VITE_API_BASE 留空，由 nginx 同源转发。
VITE_API_BASE=
VITE_APP_ENV=dev