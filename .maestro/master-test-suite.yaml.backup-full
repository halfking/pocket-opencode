appId: com.kaixuan.opencode.pocket
---
# ═══════════════════════════════════════════════════════════════════
# OpenPocket 主测试套件 (Master Test Suite)
# ═══════════════════════════════════════════════════════════════════
# 
# 用途：完整验证应用的所有核心功能
# 执行时间：约 15-20 分钟
# 覆盖范围：34 个前端域中的 20+ 核心功能
#
# 测试分层：
#   L0 - 启动与认证 (必须通过)
#   L1 - 核心功能 (AI/Notes/Email)
#   L2 - 扩展功能 (Meetings/Tasks/RSS)
#   L3 - 高级功能 (ACC/Gateway/Vault)
#
# 前置条件：
#   - 后端服务运行在 127.0.0.1:18099 (或已配置端口转发)
#   - 测试账号: admin / Veritrans&9527
#   - 主密码: ${POCKET_MASTER} (环境变量)
#
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# L0: 启动与认证
# ═══════════════════════════════════════════════════════════════════

- launchApp:
    clearState: true

- extendedWaitUntil:
    visible: ".*AI Work Mess.*|.*AI 工具.*"
    timeout: 60000

# 执行登录流程（处理四种状态：已登录/未登录/锁定/无主密码）
- runFlow: _login.yaml

- takeScreenshot: "suite-00-login-complete"

# ═══════════════════════════════════════════════════════════════════
# L1: 核心功能测试
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 1.1 AI 工具 - 任务看板
# ───────────────────────────────────────────────────────────────────
- tapOn: "^首页$|^Home$|^AI$"
- extendedWaitUntil:
    visible: ".*AI 工具.*"
    timeout: 10000

- assertVisible: ".*快速提问.*"
- takeScreenshot: "suite-01-ai-dashboard"

# 测试快速提问
- tapOn: "快速提问"
- extendedWaitUntil:
    visible: ".*"
    timeout: 2000
- takeScreenshot: "suite-02-quick-question"

# 返回首页（使用导航按钮而非BACK键）
- tapOn: "^首页$|^Home$|^AI$"
- extendedWaitUntil:
    visible: ".*AI 工具.*"
    timeout: 5000
- takeScreenshot: "suite-02b-back-to-home"


# ───────────────════════════════════════════════════════════════════
# ───────────────────────────────────────────────────────────────────
# 1.2 笔记 - 创建与录音
# ───────────────────────────────────────────────────────────────────
- tapOn: "笔记|Notes"
- extendedWaitUntil:
    visible: ".*"
    timeout: 10000
- takeScreenshot: "suite-03-notes-list"

# 创建新笔记
- tapOn: "新建笔记|New note"
- extendedWaitUntil:
    visible: ".*"
    timeout: 5000
- assertVisible: "语音输入"
- takeScreenshot: "suite-04-note-new"

# ───────────────────────────────────────────────────────────────────
# 1.3 消息中心
# ───────────────────────────────────────────────────────────────────
- tapOn: "消息|Messages"
- extendedWaitUntil:
    visible: ".*消息.*|.*Messages.*"
    timeout: 10000

- takeScreenshot: "suite-06-messages"
- extendedWaitUntil:
    visible: ".*"
    timeout: 2000

# ═══════════════════════════════════════════════════════════════════
# L2: 扩展功能测试
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 2.1 更多菜单 - 导航测试
# ───────────────────────────────────────────────────────────────────
- tapOn: "更多|More"
- extendedWaitUntil:
    visible: ".*更多.*|.*More.*"
    timeout: 10000

- takeScreenshot: "suite-07-more-menu"

# 测试邮箱入口
- tapOn: "邮箱|Email"
- extendedWaitUntil:
    visible: ".*"
    timeout: 3000
- takeScreenshot: "suite-08-email-view"

# 返回更多菜单
- pressKey: BACK
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

# ───────────────────────────────────────────────────────────────────
# 2.2 会议工作台
# ───────────────────────────────────────────────────────────────────
- tapOn: "更多|More"
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

# 滚动查找会议入口
- scroll
- extendedWaitUntil:
    visible: ".*"
    timeout: 500

- runFlow:
    when:
      visible: ".*会议.*|.*Meetings.*"
    commands:
      - tapOn: "会议|Meetings"
      - extendedWaitUntil:
          visible: ".*"
          timeout: 3000
      - takeScreenshot: "suite-09-meetings"
      - pressKey: BACK
      - extendedWaitUntil:
          visible: ".*"
          timeout: 1000

# ───────────────────────────────────────────────────────────────────
# 2.3 任务看板（ACC Integration）
# ───────────────────────────────────────────────────────────────────
- tapOn: "更多|More"
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

- runFlow:
    when:
      visible: ".*任务看板.*|.*Task Board.*"
    commands:
      - tapOn: "任务看板|Task Board"
      - extendedWaitUntil:
          visible: ".*"
          timeout: 3000
      - takeScreenshot: "suite-10-acc-board"
      - pressKey: BACK
      - extendedWaitUntil:
          visible: ".*"
          timeout: 1000

# ───────────────────────────────────────────────────────────────────
# 2.4 RSS 订阅
# ───────────────────────────────────────────────────────────────────
- tapOn: "更多|More"
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

- runFlow:
    when:
      visible: ".*RSS.*|.*RSS 订阅.*"
    commands:
      - tapOn: "RSS|RSS 订阅"
      - extendedWaitUntil:
          visible: ".*"
          timeout: 3000
      - takeScreenshot: "suite-11-rss"
      - pressKey: BACK
      - extendedWaitUntil:
          visible: ".*"
          timeout: 1000

# ═══════════════════════════════════════════════════════════════════
# L3: 高级功能测试
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 3.1 设置 - LLM 网关
# ───────────────────────────────────────────────────────────────────
- tapOn: "更多|More"
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

- tapOn: "设置|Settings"
- extendedWaitUntil:
    visible: ".*"
    timeout: 3000
- takeScreenshot: "suite-12-settings"

- runFlow:
    when:
      visible: ".*LLM 网关.*|.*LLM Gateway.*"
    commands:
      - tapOn: "LLM 网关|LLM Gateway"
      - extendedWaitUntil:
          visible: ".*"
          timeout: 3000
      - takeScreenshot: "suite-13-llm-gateway"
      - pressKey: BACK
      - extendedWaitUntil:
          visible: ".*"
          timeout: 1000

# 返回首页
- pressKey: BACK
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

# ───────────────────────────────────────────────────────────────────
# 3.2 密码箱（需要生物认证）
# ───────────────────────────────────────────────────────────────────
- tapOn: "更多|More"
- extendedWaitUntil:
    visible: ".*"
    timeout: 1000

- scroll
- runFlow:
    when:
      visible: ".*密码箱.*|.*Vault.*"
    commands:
      - tapOn: "密码箱|Vault"
      - extendedWaitUntil:
          visible: ".*"
          timeout: 3000
      - takeScreenshot: "suite-14-vault"
      - pressKey: BACK
      - extendedWaitUntil:
          visible: ".*"
          timeout: 1000

# ═══════════════════════════════════════════════════════════════════
# 最终验证
# ═══════════════════════════════════════════════════════════════════

# 返回首页
- tapOn: "^首页$|^Home$|^AI$"
- extendedWaitUntil:
    visible: ".*AI 工具.*"
    timeout: 10000

- assertVisible: ".*快速提问.*"
- assertNotVisible: "密码登录"

- takeScreenshot: "suite-99-final-home"

# ═══════════════════════════════════════════════════════════════════
# 测试完成
# ═══════════════════════════════════════════════════════════════════
