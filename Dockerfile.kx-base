# ── Build Stage ──────────────────────────────────────────────────────────────
# Uses kx-base:go-vue-optimized (kx-base-go-vue-v2-alpine-slim-arm64.tar.gz)
# as the Go build environment. The runtime stage is plain alpine — pocketd is
# a static Go binary, no Node/Python needed at runtime.
#
# Build args:
#   KX_BASE_TAG         — defaults to kx-base:go-vue-optimized (the tag the
#                         arm64 offline tarball uses per manifest.json).
#                         Override to test against a fresh build.
#   RUNTIME_BASE_IMAGE  — defaults to alpine:latest; override to lock the
#                         runtime OS image.
#
# Network: builds assume the kx-base image is already loaded locally via
#   `docker load -i ~/work/docker-base-images/lang-base/kx-base-go-vue-v2-alpine-slim-arm64.tar.gz`
# The compose uses `pull_policy: never` and `network: host` so the build
# never reaches the registry. Offline-safe.

ARG KX_BASE_TAG=kx-base:go-vue-optimized
ARG RUNTIME_BASE_IMAGE=alpine:latest

FROM ${KX_BASE_TAG} AS builder

# kx-base metadata may set USER appuser without a matching passwd entry.
USER root

# China network: proxy.golang.org unreachable in some build envs; goproxy.cn is
# the standard fallback. The kx-base image already has Go installed.
ENV GOPROXY=https://goproxy.cn,direct \
    CGO_ENABLED=0 \
    GOOS=linux

WORKDIR /src
COPY backend/go.mod backend/go.sum ./backend/
COPY backend/third_party ./backend/third_party
RUN cd backend && go mod download

COPY backend ./backend
# 2026-09-08: user_settings dual-store + kaixuan gateway seed
RUN cd backend && go build -trimpath -ldflags='-s -w' -o /out/pocketd ./cmd/pocketd && \
    grep -q user-settings /out/pocketd || (echo 'pocketd missing /api/user-settings' >&2; exit 1)

# ── Runtime Stage ────────────────────────────────────────────────────────────
FROM ${RUNTIME_BASE_IMAGE}

RUN apk --no-cache add ca-certificates wget && \
    addgroup -S pocket && adduser -S -G pocket pocket

WORKDIR /app
COPY --from=builder /out/pocketd /app/pocketd

# 版本配置必须打进镜像，否则 /api/app/check-update 恒 503。
# 服务端契约（loadVersionConfig）是拿不到配置就返回 ErrVersionConfigNotFound，
# 由 handleCheckUpdate 翻成 503 —— 按设计行事，不要改成静默回落默认值。
#
# 这一行是实际生效的那一处：本地/服务器部署都走 deploy/bin/docker-compose.opp.yml
# 的 build 段（dockerfile: Dockerfile.kx-base，context 是仓库根），
# 而**不是** build-images.sh 那条交叉编译路径。修 Dockerfile.pocketd-prebuilt
# 不改这里，重建出来的镜像依然没有 config/ —— 踩过一次，别再漏。
#
# 构建上下文是仓库根，源文件就在 backend/config/version.json，无需额外配置。
COPY backend/config/version.json /app/config/version.json

RUN mkdir -p /app/data && chown -R pocket:pocket /app

USER pocket
EXPOSE 8088

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
    CMD wget -q -O- http://127.0.0.1:8088/healthz >/dev/null || exit 1

ENTRYPOINT ["/app/pocketd"]