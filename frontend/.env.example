# Schema reference for per-platform / per-environment API base URLs.
#
# Files matching .env.* are gitignored. Copy this template into the right
# profile for your local setup, e.g.:
#
#   cp .env.example .env.ios-dev
#   cp .env.example .env.staging
#
# Required profile naming (consumed by scripts/build-mobile.mjs):
#
#   .env.android-dev    → mode=android-dev → build-mobile.js android dev
#   .env.ios-dev        → mode=ios-dev     → build-mobile.js ios dev
#   .env.staging        → mode=staging     → build-mobile.js <ios|android> staging
#   .env.production     → mode=production  → build-mobile.js <ios|android> prod
#
# Override at build time without editing the file:
#   VITE_API_BASE=http://your-host:8088 node scripts/build-mobile.mjs ios dev
#
# 192.168.x.x is the dev workstation's LAN IP — iOS real-device builds need
# this (NOT localhost) because real devices don't share the host's loopback.

# VITE_API_BASE=
# VITE_APP_ENV=dev