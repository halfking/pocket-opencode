# openpocket × RedClaw 认证联调环境 (docker run --env-file 用)
# 生成时间: 2026-09-05; 密钥与 RedClaw deploy/local-stack/config/deploy.env 对齐
POCKET_ENV=development
POCKET_HTTP_PORT=8088
POCKET_JWT_SECRET=REPLACE_WITH_LOCAL_TEST_SECRET_MIN_32_CHARS
POCKET_ALLOWED_ORIGINS=http://localhost:4175,http://localhost:18091

# dev 旁路 (RedClaw 不可达降级测试用)
POCKET_DEV_AUTH=true
POCKET_AUTH_USER=admin
POCKET_AUTH_PASS=admin-local-dev-only

# ---- RedClaw 认证主权威源 ----
POCKET_REDCLAW_ADMIN_URL=http://host.docker.internal:27093
POCKET_REDCLAW_ADMIN_SECRET=REPLACE_WITH_LOCAL_TEST_SECRET_MIN_32_CHARS
POCKET_REDCLAW_AUTH_AGENT_URL=http://host.docker.internal:27092
POCKET_REDCLAW_ADMIN_TIMEOUT_SEC=10
POCKET_REDCLAW_SSO_ENABLED=true

# ---- RedClaw Gateway (bridge / users-verify) ----
POCKET_REDCLAW_BASE_URL=http://host.docker.internal:27081
POCKET_REDCLAW_SECRET=REPLACE_WITH_LOCAL_TEST_SECRET_MIN_32_CHARS
POCKET_REDCLAW_TENANT_ID=default
POCKET_REDCLAW_TIMEOUT_SEC=30

# ---- RedClaw auth-agent 镜像客户端 (register/reset/code-login 事件) ----
POCKET_REDCLAW_AUTH_URL=http://host.docker.internal:27092
POCKET_REDCLAW_AUTH_SECRET=REPLACE_WITH_LOCAL_TEST_SECRET_MIN_32_CHARS
POCKET_REDCLAW_AUTH_TIMEOUT_SEC=5

# ---- identity-go 跨项目互信 (与 RedClaw ADMIN_JWT_SIGNING_KEY 同源) ----
IDENTITY_SHARED_SECRET=REPLACE_WITH_LOCAL_TEST_SECRET_MIN_32_CHARS
IDENTITY_ISSUER_ALLOWLIST=redclaw,memora,llm-gateway,pocket,acc

# ---- SSO 回调链（2026-09-05 修复后）----
# RedClaw 本地栈侧需同步配置（config/deploy.env，非本文件）：
#   OIDC_REDIRECT_URL=http://localhost:18090/api/auth/sso/callback
# pocket 侧无需额外变量；绑定 cookie 与一次性 code 由 pocketd 自动启用。
