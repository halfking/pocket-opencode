POCKET_HTTP_PORT=8088
POCKET_DB_PATH=./data/pocket.sqlite
POCKET_INSTANCE_DISCOVERY_BASE_URL=https://discovery.example.internal
POCKET_INSTANCE_DISCOVERY_AUTH_TOKEN=<INSTANCE_DISCOVERY_AUTH_TOKEN>
POCKET_INSTANCE_CATALOG_JSON='[{"id":"demo-main","displayName":"Demo Main","apiBaseURL":"https://opencode.example.internal","environment":"development"}]'
POCKET_OPENCODE_TIMEOUT_MS=5000
POCKET_WS_HEARTBEAT_MS=15000
POCKET_REMINDER_CHECK_INTERVAL_SEC=60
POCKET_ANDROID_APP_ID=com.kaixuan.opencode.pocket
POCKET_ANDROID_USE_CAPACITOR=true

# ---- Phase 0: 个人助理模块配置 ----
# 数据库
POCKET_POSTGRES_DSN=postgresql://user:password@localhost:5432/pocket?sslmode=disable

# AI/STT 后端
POCKET_GROQ_API_KEY=<GROQ_API_KEY>
POCKET_KXMEMORY_BASE_URL=http://localhost:8000

# 邮箱模块
POCKET_EMAIL_MASTER_KEY=<32_BYTE_HEX_KEY>
POCKET_EMAIL_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
POCKET_EMAIL_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
POCKET_EMAIL_MICROSOFT_CLIENT_ID=<MICROSOFT_CLIENT_ID>
POCKET_EMAIL_MICROSOFT_CLIENT_SECRET=<MICROSOFT_CLIENT_SECRET>
POCKET_EMAIL_OAUTH_REDIRECT_URL=http://localhost:8088/callback/email/oauth
POCKET_EMAIL_FETCH_ENABLED=true

# 任务系统整合（Phase 5）
POCKET_MCP_BASE_URL=https://mcp.kxpms.cn/acc/mcp
POCKET_MCP_API_KEY=<MCP_API_KEY>
POCKET_MCP_INSECURE_TLS=false

# 认证（Phase 1）
POCKET_JWT_SECRET=<STRONG_SECRET_32_BYTES_OR_MORE>
# Development only; disable in production.
POCKET_DEV_AUTH=true
POCKET_AUTH_USER=admin
# Quote any value containing shell-significant characters ('&', spaces, '$').
# Unquoted `POCKET_AUTH_PASS=a&b` is truncated to `a` by any shell/loader that
# evals the line, and the failure is silent: the backend boots, /healthz answers
# 200, and every login is rejected as a wrong password. See
# scripts/start-local-backend.sh, which refuses to start on this.
POCKET_AUTH_PASS='<SET_LOCALLY_MIN_8_CHARS>'

# 飞书事件回调
POCKET_FEISHU_APP_ID=<FEISHU_APP_ID>
POCKET_FEISHU_APP_SECRET=<FEISHU_APP_SECRET>
POCKET_FEISHU_VERIFY_TOKEN=<FEISHU_VERIFY_TOKEN>
POCKET_FEISHU_VERIFY_SECRET=<FEISHU_VERIFY_SECRET>
POCKET_FEISHU_ENCRYPT_KEY=<FEISHU_ENCRYPT_KEY>

# 企业微信（WeCom）自建应用事件回调 —— m.kxpms.cn/callback/weixin
#
# 三项**缺一不可**：任一为空时，带签名的请求一律 503 拒绝。
# 这是有意的：配不全就放行等于把回调端点变成任何人都能伪造的公开入口。
#
# 注意 2026-10-02 用户提供的「微信 appid/appkey」与飞书那对完全相同
# （cli_aac806f6bab89bd8 / ZrDW…），cli_ 是飞书的 appid 格式，
# 企业微信应为 ww 开头。本实现只用到下面三项，appid/appsecret 不参与回调。
POCKET_WECOM_TOKEN=<WECOM_TOKEN>
# 43 个字符的 EncodingAESKey（**不含结尾 '='**，程序会自己补）
POCKET_WECOM_ENCODING_AES_KEY=<WECOM_ENCODING_AES_KEY>
# 企业 ID（CorpID），用于校验密文尾部的 receiveid
POCKET_WECOM_CORP_ID=<WECOM_CORP_ID>

# ---- Phase C: 龙虾无状态 AI 网关 ----
# 嵌入 API（OpenAI 或兼容端点）
POCKET_EMBED_BASE_URL=https://api.openai.com/v1
POCKET_EMBED_API_KEY=<OPENAI_API_KEY>
POCKET_OPENAI_API_KEY=<OPENAI_API_KEY>
POCKET_EMBED_MODEL=text-embedding-3-small

# LLM API（Groq 或兼容端点）
POCKET_LLM_BASE_URL=https://api.groq.com/openai/v1
POCKET_LLM_API_KEY=<GROQ_API_KEY>
POCKET_LLM_MODEL=llama-3.3-70b-versatile

# 后端集成：AI 网关（OpenAI 兼容 /v1/chat/completions）。
# 默认 https://llm.kxpms.cn/v1。API Key 只从 envs 注入，禁止写真值。
# 也可在「设置 → AI 网关」运行时填写，无需重启。
POCKET_LLM_GATEWAY_URL=https://llm.kxpms.cn/v1
POCKET_LLM_GATEWAY_API_KEY=

# AI 对话智能体角色库（agency-agents-zh 仓库路径）
# 启动时自动导入内置角色（215+ 个专家角色）。未设置时仅跳过导入，用户仍可创建自定义角色。
# 示例：POCKET_AGENTS_REPO_PATH=/path/to/agency-agents-zh
POCKET_AGENTS_REPO_PATH=

# ===========================================================================
# 运行时与安全基线
#
# 2026-10-04 补齐。此前这些项 backend 一直在读，但 .env.example 里没有 ——
# 照本文件配出来的服务能启动、/healthz 回 200，而它们全是空值，
# 只有真正用到对应功能时才炸（2026-10-04 实测：回调端点因为一个
# FEISHU/WECOM 变量都没配而 503）。
#
# 约定：**留空 = 用代码里的默认值**（config.go 的 getEnv 遇空值回落）。
# 所以下面标注了「默认：」的项留空即可，不要把默认值内联进来 ——
# 内联等于把代码默认值复制一份，两边迟早会分叉。
# ===========================================================================

# 运行环境。production/prod 会让飞书回调在缺签名密钥时 fail-closed（503 拒绝）。
POCKET_ENV=
# 默认：development
# 数据目录（发票文件、master key、正文缓存、chat_agents 库都落这里）
POCKET_DATA_DIR=
# PostgreSQL schema。所有查询都必须走它，否则会打到共享库。
POCKET_PG_SCHEMA=
# 默认：opencode_pocket
# 允许的 CORS 来源，逗号分隔。留空 = 不限制。
POCKET_ALLOWED_ORIGINS=
# 时区偏移（秒）。影响定时任务的「今天」边界。
POCKET_TIMEZONE_OFFSET_SEC=
# 默认：28800（UTC+8）
# APK 下载路径。默认：/data/www/pocket.kxpms.cn/downloads/opencode-pocket-latest.apk
POCKET_APK_DOWNLOAD_PATH=
# 只允许旧式登录（关掉密码登录）。留空 = 关闭。
POCKET_AUTH_LEGACY_ONLY=

# WebAuthn / Passkey 的 Relying Party。三个都空 = 不启用 WebAuthn。
# 配了 rpId 但 origin 对不上，真机注册会失败且报错不易懂。
POCKET_WEBAUTHN_RP_ID=
POCKET_WEBAUTHN_RP_ORIGIN=
POCKET_WEBAUTHN_RP_DISPLAY_NAME=

# 伴侣端（companion）对接。secret 为空时不启用。
POCKET_COMPANION_URL=
POCKET_COMPANION_SECRET=

# 技能市场根公钥。留空 = 不校验签名。
POCKET_MARKETPLACE_ROOT_PUBKEY=

# ---- 实例发现 ----
# 局域网实例发现：扫描端口范围、额外主机、是否扫整个子网。
POCKET_DISCOVERY_PORTS=
POCKET_DISCOVERY_EXTRA_HOSTS=
POCKET_DISCOVERY_FULL_SUBNET=
# NPS 兼容的旧变量名，与上面 INSTANCE_DISCOVERY_* 二选一即可。
POCKET_NPS_BASE_URL=
POCKET_NPS_AUTH_KEY=
POCKET_NPS_AUTH_CRYPT_KEY=
POCKET_INSTANCE_DISCOVERY_AUTH_SECRET=
# 旧版实例目录 JSON。已由 POCKET_INSTANCE_CATALOG_JSON 取代，留空兼容。
POCKET_OPENCODE_INSTANCES=

# ---- 邮件抓取与流水线 ----
# 执行模式：local | server。server 会把分类/整理交给 POCKET_EMAIL_SERVER_PIPELINE_URL。
POCKET_EMAIL_EXECUTION_MODE=
# 默认：local
POCKET_EMAIL_SERVER_PIPELINE_URL=
# 走 LLM 网关做分类（留空 = 走本地 kxmemory）。
POCKET_EMAIL_CLASSIFY_VIA_GATEWAY=
# 垃圾邮件清理的干跑开关。默认 true —— 生产上**不要**关，除非确认过规则不会误删。
POCKET_EMAIL_SPAM_DRYRUN=
# 默认：true
# IMAP STARTTLS / 跳过证书校验。跳过校验只在内网自签证书时用。
POCKET_EMAIL_IMAP_USE_STARTTLS=
POCKET_EMAIL_IMAP_INSECURE_SKIP_VERIFY=
# 每日流水线的小时（0-23）与跨实例咨询锁。
POCKET_EMAIL_PIPELINE_HOUR=
# 默认：8
POCKET_EMAIL_PIPELINE_ADVISORY_LOCK=
# 默认：true
# A4 网格导出格数：2=2x2，3=3x3。0 = 不导出。
POCKET_EMAIL_A4_GRID=
# 默认：0

# ---- SMTP 发信 ----
POCKET_SMTP_HOST=
POCKET_SMTP_PORT=
# 默认：587
POCKET_SMTP_TLS_MODE=
# 默认：starttls（QQ/企业邮 465 用 ssl/implicit）
POCKET_SMTP_USER=
POCKET_SMTP_PASSWORD=
POCKET_SMTP_FROM=
# 把发信内容打到日志。仅调试用，会泄漏正文。
POCKET_SMTP_DEBUG_ECHO=

# ---- 飞书发票推送（可选；不配就不推）----
POCKET_FEISHU_INVOICE_CHAT_ID=
POCKET_FEISHU_INVOICE_FOLDER_TOKEN=

# ---- RSS 订阅 ----
# 时长类变量接受 Go duration 串（30s / 15m）或裸整数（按秒）。
POCKET_RSS_ENABLED=
# 默认：true
POCKET_RSS_FETCH_INTERVAL=
# 默认：60s
POCKET_RSS_SOURCE_INTERVAL=
# 默认：15m
POCKET_RSS_HTTP_TIMEOUT=
# 默认：15s
POCKET_RSS_MAX_BODY_BYTES=
# 默认：4194304（4<<20）
POCKET_RSS_MAX_CONCURRENCY=
# 默认：4
POCKET_RSS_RETENTION_DAYS=
# 默认：30
POCKET_RSS_PUBLISH_MODE=
# 默认：share_only
# 每日摘要
POCKET_RSS_DIGEST_ENABLED=
# 默认：true
POCKET_RSS_DIGEST_STARTUP_RUN=
# 默认：true
POCKET_RSS_DIGEST_INCLUDE_SUMMARY=
# 默认：true
POCKET_RSS_DIGEST_HOUR=
# 默认：8
POCKET_RSS_DIGEST_MINUTE=
# 默认：30
POCKET_RSS_DIGEST_MAX_PER_SECTION=
# 默认：8
# 发现源（微博等）与搜索
POCKET_RSS_WEIBO_CLIENT_ID=
POCKET_RSS_WEIBO_CLIENT_SECRET=
POCKET_RSS_WEIBO_REDIRECT_URL=
POCKET_RSS_DISCOVERY_SEARCH_URL=
POCKET_RSS_DISCOVERY_SEARCH_API_KEY=

# ---- 定时任务调度器 ----
POCKET_SCHEDULER_ENABLED=
# 默认：true
POCKET_SCHEDULER_TICK_INTERVAL=
# 默认：5s
POCKET_SCHEDULER_WEBHOOK_TIMEOUT=
# 默认：30s
POCKET_SCHEDULER_MAX_PARALLEL=
# 默认：4
POCKET_SCHEDULER_ADVISORY_LOCK=
# 默认：true

# ---- kxmemory 分类服务 ----
POCKET_KXMEMORY_NOTE_CLASSIFY_PATH=
# 默认：/v1/notes/classify
POCKET_KXMEMORY_EMAIL_CLASSIFY_PATH=
# 默认：/v1/emails/classify
POCKET_KXMEMORY_DAILY_SUMMARY_PATH=
# 默认：/v1/emails/daily-summary

# ---- MCP 接入 ----
POCKET_MCP_TENANT_ID=
POCKET_MCP_SCOPES=
# 默认：tasks,sessions

# ---- redclaw 网关 ----
POCKET_REDCLAW_BASE_URL=
POCKET_REDCLAW_SECRET=
POCKET_REDCLAW_TENANT_ID=
# 默认：default
POCKET_REDCLAW_TIMEOUT_SEC=
# 默认：30
POCKET_REDCLAW_AUTH_URL=
POCKET_REDCLAW_AUTH_SECRET=
POCKET_REDCLAW_AUTH_AGENT_URL=
POCKET_REDCLAW_AUTH_TIMEOUT_SEC=
# 默认：5
POCKET_REDCLAW_ADMIN_URL=
POCKET_REDCLAW_ADMIN_SECRET=
POCKET_REDCLAW_ADMIN_TIMEOUT_SEC=
# 默认：10
POCKET_REDCLAW_SSO_ENABLED=
POCKET_REDCLAW_LLM_FALLBACK=

# ---- 磁盘会话 ----
POCKET_DISK_SESSIONS_ENABLED=
POCKET_DISK_SESSIONS_WORKSPACE=
POCKET_DISK_HOME=


