POCKET_HTTP_PORT=8088
POCKET_DB_PATH=./data/pocket.sqlite
POCKET_INSTANCE_DISCOVERY_BASE_URL=https://discovery.example.internal
POCKET_INSTANCE_DISCOVERY_AUTH_TOKEN=<INSTANCE_DISCOVERY_AUTH_TOKEN>
POCKET_INSTANCE_CATALOG_JSON='[{"id":"demo-main","displayName":"Demo Main","apiBaseURL":"https://opencode.example.internal","environment":"development"}]'
POCKET_OPENCODE_TIMEOUT_MS=5000
POCKET_WS_HEARTBEAT_MS=15000
POCKET_REMINDER_CHECK_INTERVAL_SEC=60
POCKET_ANDROID_APP_ID=com.kaixuan.opencode.pocket
POCKET_ANDROID_USE_CAPACITOR=true

# ---- Phase 0: 个人助理模块配置 ----
# 数据库
POCKET_POSTGRES_DSN=postgresql://user:password@localhost:5432/pocket?sslmode=disable

# AI/STT 后端
POCKET_GROQ_API_KEY=<GROQ_API_KEY>
POCKET_KXMEMORY_BASE_URL=http://localhost:8000

# 邮箱模块
POCKET_EMAIL_MASTER_KEY=<32_BYTE_HEX_KEY>
POCKET_EMAIL_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
POCKET_EMAIL_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
POCKET_EMAIL_MICROSOFT_CLIENT_ID=<MICROSOFT_CLIENT_ID>
POCKET_EMAIL_MICROSOFT_CLIENT_SECRET=<MICROSOFT_CLIENT_SECRET>
POCKET_EMAIL_OAUTH_REDIRECT_URL=http://localhost:8088/callback/email/oauth
POCKET_EMAIL_FETCH_ENABLED=true

# 任务系统整合（Phase 5）
POCKET_MCP_BASE_URL=https://mcp.kxpms.cn/acc/mcp
POCKET_MCP_API_KEY=<MCP_API_KEY>
POCKET_MCP_INSECURE_TLS=false

# 认证（Phase 1）
POCKET_JWT_SECRET=<STRONG_SECRET_32_BYTES_OR_MORE>
# Development only; disable in production.
POCKET_DEV_AUTH=true
POCKET_AUTH_USER=admin
POCKET_AUTH_PASS=<SET_LOCALLY_MIN_8_CHARS>

# 飞书事件回调
POCKET_FEISHU_APP_ID=<FEISHU_APP_ID>
POCKET_FEISHU_APP_SECRET=<FEISHU_APP_SECRET>
POCKET_FEISHU_VERIFY_TOKEN=<FEISHU_VERIFY_TOKEN>
POCKET_FEISHU_VERIFY_SECRET=<FEISHU_VERIFY_SECRET>
POCKET_FEISHU_ENCRYPT_KEY=<FEISHU_ENCRYPT_KEY>

# 企业微信（WeCom）自建应用事件回调 —— m.kxpms.cn/callback/weixin
#
# 三项**缺一不可**：任一为空时，带签名的请求一律 503 拒绝。
# 这是有意的：配不全就放行等于把回调端点变成任何人都能伪造的公开入口。
#
# 注意 2026-10-02 用户提供的「微信 appid/appkey」与飞书那对完全相同
# （cli_aac806f6bab89bd8 / ZrDW…），cli_ 是飞书的 appid 格式，
# 企业微信应为 ww 开头。本实现只用到下面三项，appid/appsecret 不参与回调。
POCKET_WECOM_TOKEN=<WECOM_TOKEN>
# 43 个字符的 EncodingAESKey（**不含结尾 '='**，程序会自己补）
POCKET_WECOM_ENCODING_AES_KEY=<WECOM_ENCODING_AES_KEY>
# 企业 ID（CorpID），用于校验密文尾部的 receiveid
POCKET_WECOM_CORP_ID=<WECOM_CORP_ID>

# ---- Phase C: 龙虾无状态 AI 网关 ----
# 嵌入 API（OpenAI 或兼容端点）
POCKET_EMBED_BASE_URL=https://api.openai.com/v1
POCKET_EMBED_API_KEY=<OPENAI_API_KEY>
POCKET_OPENAI_API_KEY=<OPENAI_API_KEY>
POCKET_EMBED_MODEL=text-embedding-3-small

# LLM API（Groq 或兼容端点）
POCKET_LLM_BASE_URL=https://api.groq.com/openai/v1
POCKET_LLM_API_KEY=<GROQ_API_KEY>
POCKET_LLM_MODEL=llama-3.3-70b-versatile

# 后端集成：AI 网关（OpenAI 兼容 /v1/chat/completions）。
# 默认 https://llm.kxpms.cn/v1。API Key 只从 envs 注入，禁止写真值。
# 也可在「设置 → AI 网关」运行时填写，无需重启。
POCKET_LLM_GATEWAY_URL=https://llm.kxpms.cn/v1
POCKET_LLM_GATEWAY_API_KEY=

# AI 对话智能体角色库（agency-agents-zh 仓库路径）
# 启动时自动导入内置角色（215+ 个专家角色）。未设置时仅跳过导入，用户仍可创建自定义角色。
# 示例：POCKET_AGENTS_REPO_PATH=/path/to/agency-agents-zh
POCKET_AGENTS_REPO_PATH=

