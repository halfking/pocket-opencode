package server

import (
	"bytes"
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/halfking/pocket-opencode/backend/internal/aigate"
)

// MockLLMClient 模拟 LLM 客户端用于测试
type MockLLMClient struct {
	responses map[string]string
}

func (m *MockLLMClient) Chat(ctx context.Context, model string, messages []aigate.ChatMessage) (string, error) {
	// 根据输入返回模拟翻译结果
	for _, msg := range messages {
		if msg.Role == "user" {
			if m.responses != nil {
				if resp, ok := m.responses[msg.Content]; ok {
					return resp, nil
				}
			}
			// 默认简单翻译
			if strings.Contains(msg.Content, "Hello") {
				return "你好", nil
			}
			if strings.Contains(msg.Content, "how are you") {
				return "你好吗", nil
			}
			return "翻译结果", nil
		}
	}
	return "默认翻译", nil
}

// TestTranslateHandler 测试翻译处理器
func TestTranslateHandler(t *testing.T) {
	// 创建测试服务器
	s := &Server{
		llm: &MockLLMClient{
			responses: map[string]string{
				"Translate the following English text to Chinese:\n\nHello": "你好",
			},
		},
	}

	// 测试用例
	tests := []struct {
		name           string
		requestBody    map[string]interface{}
		expectedStatus int
		checkResponse  func(*testing.T, map[string]interface{})
	}{
		{
			name: "成功翻译",
			requestBody: map[string]interface{}{
				"text":       "Hello",
				"sourceLang": "en",
				"targetLang": "zh",
			},
			expectedStatus: http.StatusOK,
			checkResponse: func(t *testing.T, resp map[string]interface{}) {
				if resp["translation"] == nil {
					t.Error("响应中缺少 translation 字段")
				}
				if resp["detectedLang"] == nil {
					t.Error("响应中缺少 detectedLang 字段")
				}
				if resp["model"] == nil {
					t.Error("响应中缺少 model 字段")
				}
			},
		},
		{
			name: "缺少必需字段",
			requestBody: map[string]interface{}{
				"text": "Hello",
				// 缺少 targetLang
			},
			expectedStatus: http.StatusBadRequest,
			checkResponse:  nil,
		},
		{
			name: "文本过长",
			requestBody: map[string]interface{}{
				"text":       string(make([]byte, 6000)),
				"targetLang": "zh",
			},
			expectedStatus: http.StatusBadRequest,
			checkResponse:  nil,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// 创建请求
			body, _ := json.Marshal(tt.requestBody)
			req := httptest.NewRequest("POST", "/api/meetings/123/translate", bytes.NewReader(body))
			req.Header.Set("Content-Type", "application/json")

			// 创建响应记录器
			w := httptest.NewRecorder()

			// 调用处理器
			s.handleMeetingTranslate(w, req)

			// 检查状态码
			if w.Code != tt.expectedStatus {
				t.Errorf("状态码 = %d, 期望 %d", w.Code, tt.expectedStatus)
			}

			// 检查响应内容
			if tt.checkResponse != nil && w.Code == http.StatusOK {
				var resp map[string]interface{}
				if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
					t.Errorf("解析响应失败: %v", err)
				} else {
					tt.checkResponse(t, resp)
				}
			}
		})
	}
}

// TestDetectLanguage 测试语言检测
func TestDetectLanguage(t *testing.T) {
	tests := []struct {
		text     string
		expected string
	}{
		{"你好世界", "zh"},
		{"Hello world", "en"},
		{"こんにちは", "ja"},
		{"안녕하세요", "ko"},
		{"", "auto"},
	}

	for _, tt := range tests {
		t.Run(tt.text, func(t *testing.T) {
			result := detectLanguage(tt.text)
			if result != tt.expected {
				t.Errorf("detectLanguage(%q) = %q, 期望 %q", tt.text, result, tt.expected)
			}
		})
	}
}

// TestBuildTranslatePrompt 测试翻译 prompt 构建
func TestBuildTranslatePrompt(t *testing.T) {
	tests := []struct {
		name       string
		text       string
		sourceLang string
		targetLang string
		contains   []string
	}{
		{
			name:       "指定源语言",
			text:       "Hello",
			sourceLang: "en",
			targetLang: "zh",
			contains:   []string{"English", "Chinese", "Hello"},
		},
		{
			name:       "自动检测",
			text:       "Hello",
			sourceLang: "auto",
			targetLang: "zh",
			contains:   []string{"Chinese", "Hello"},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			prompt := buildTranslatePrompt(tt.text, tt.sourceLang, tt.targetLang)
			for _, s := range tt.contains {
				if !strings.Contains(prompt, s) {
					t.Errorf("prompt 应包含 %q", s)
				}
			}
		})
	}
}
