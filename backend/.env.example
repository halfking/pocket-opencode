# ============================================================================
# Pocket Backend Configuration Example
# ============================================================================
# 复制此文件为 .env 并根据实际环境填写配置值
# Copy this file to .env and fill in values for your environment

# ----------------------------------------------------------------------------
# 基础服务配置 / Basic Service Configuration
# ----------------------------------------------------------------------------

# HTTP 服务端口 / HTTP server port
POCKET_HTTP_PORT=8088

# SQLite 数据库路径（已弃用，仅用于 data 目录定位）
# SQLite database path (deprecated, only for data directory location)
POCKET_DB_PATH=./data/pocket.sqlite

# PostgreSQL 数据库连接字符串（Phase 0 统一数据层）
# PostgreSQL DSN (Phase 0 unified data layer)
# 格式：postgres://user:password@host:port/dbname?sslmode=disable
POCKET_POSTGRES_DSN=
# 或者使用标准环境变量 / Or use standard DATABASE_URL
DATABASE_URL=

# ----------------------------------------------------------------------------
# 实例发现服务 / Instance Discovery Service
# ----------------------------------------------------------------------------

# NPS 服务基础 URL（实例发现）/ NPS service base URL
POCKET_NPS_BASE_URL=
# 或使用新命名 / Or use new naming
POCKET_INSTANCE_DISCOVERY_BASE_URL=

# NPS 认证令牌 / NPS auth token
POCKET_NPS_AUTH_KEY=
# 或使用新命名 / Or use new naming
POCKET_INSTANCE_DISCOVERY_AUTH_TOKEN=

# NPS 认证加密密钥 / NPS auth encryption key
POCKET_NPS_AUTH_CRYPT_KEY=
# 或使用新命名 / Or use new naming
POCKET_INSTANCE_DISCOVERY_AUTH_SECRET=

# OpenCode 实例列表 JSON 配置 / OpenCode instances JSON catalog
POCKET_OPENCODE_INSTANCES=
# 或使用新命名 / Or use new naming
POCKET_INSTANCE_CATALOG_JSON=

# OpenCode 请求超时（毫秒）/ OpenCode request timeout in milliseconds
POCKET_OPENCODE_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# WebSocket 配置 / WebSocket Configuration
# ----------------------------------------------------------------------------

# WebSocket 心跳间隔（毫秒）/ WebSocket heartbeat interval in milliseconds
POCKET_WS_HEARTBEAT_MS=15000

# ----------------------------------------------------------------------------
# 提醒服务 / Reminder Service
# ----------------------------------------------------------------------------

# 提醒检查间隔（秒）/ Reminder check interval in seconds
POCKET_REMINDER_CHECK_INTERVAL_SEC=60

# ----------------------------------------------------------------------------
# Android 应用配置 / Android App Configuration
# ----------------------------------------------------------------------------

# Android 应用包名 / Android app package ID
POCKET_ANDROID_APP_ID=com.kaixuan.opencode.pocket

# 是否使用 Capacitor Shell / Use Capacitor shell
POCKET_ANDROID_USE_CAPACITOR=true

# ----------------------------------------------------------------------------
# 飞书集成 / Feishu (Lark) Integration
# ----------------------------------------------------------------------------

# 飞书应用 ID / Feishu app ID
POCKET_FEISHU_APP_ID=

# 飞书应用密钥 / Feishu app secret
POCKET_FEISHU_APP_SECRET=

# 飞书验证 Token（url_verification 事件）/ Feishu verify token
POCKET_FEISHU_VERIFY_TOKEN=

# 飞书签名验证密钥（X-Lark-Signature，留空 = dev 模式跳过）
# Feishu signature secret (leave empty for dev mode skip)
POCKET_FEISHU_VERIFY_SECRET=

# 飞书加密密钥（V1 事件解密，V2 不需要）/ Feishu encrypt key (V1 only)
POCKET_FEISHU_ENCRYPT_KEY=

# ----------------------------------------------------------------------------
# 认证 / Authentication (Phase 0 + RedClaw 一期切换)
# ----------------------------------------------------------------------------
# 一期切换后（2026-09）认证主权威源切到 RedClaw Admin：openpocket 不再自签
# JWT，仅做 token 透传。下列四个 POCKET_REDCLAW_ADMIN_* 必填。
# 紧急回滚：设 POCKET_AUTH_LEGACY_ONLY=true 强制走原本地 JWT 流程。

# JWT 签名密钥（仅 legacy 模式或 identity-go 互信使用；生产必须修改！）
# JWT signing secret (legacy mode only; MUST change in production!)
POCKET_JWT_SECRET=pocket-dev-insecure-secret

# RedClaw Admin 后端地址（一期主权威源，必填）
# RedClaw Admin backend URL (primary auth source after Phase 1 switch)
# 示例：https://redclaw-admin.internal:28081
POCKET_REDCLAW_ADMIN_URL=

# RedClaw Admin 共享密钥（HS256；与 IDENTITY_SHARED_SECRET 同源；>= 32 字节）
# RedClaw Admin shared secret (HS256, >= 32 bytes)
POCKET_REDCLAW_ADMIN_SECRET=

# RedClaw Auth Agent 地址（OIDC SSO 入口；留空则与 Admin 同址）
# RedClaw Auth Agent URL (SSO entry; empty = same as Admin)
POCKET_REDCLAW_AUTH_AGENT_URL=

# RedClaw Admin HTTP 超时（秒，默认 10）
# RedClaw Admin HTTP timeout (seconds, default 10)
POCKET_REDCLAW_ADMIN_TIMEOUT_SEC=

# RedClaw 租户 ID（admin/gateway/mirror 客户端共用；默认 default）
# RedClaw tenant id shared by admin/gateway/mirror clients (default "default")
POCKET_REDCLAW_TENANT_ID=default

# RedClaw auth-agent 镜像客户端（本地注册/验证码/改密事件镜像；空 = disabled）
# RedClaw auth-agent mirror client for local register/code/reset events
POCKET_REDCLAW_AUTH_URL=
POCKET_REDCLAW_AUTH_SECRET=
POCKET_REDCLAW_AUTH_TIMEOUT_SEC=5

# 紧急回滚开关：true 时完全走原本地 JWT 流程，忽略 RedClaw 配置
# Emergency rollback: true = local JWT only, ignore RedClaw config
POCKET_AUTH_LEGACY_ONLY=

# 启用 RedClaw OIDC SSO（需 RedClaw Auth Agent 配齐 OIDC_*）
# Enable RedClaw OIDC SSO (LoginView shows extra SSO tab)
POCKET_REDCLAW_SSO_ENABLED=

# 开发模式认证（仅 legacy/回滚路径生效；生产必须不设或 false）
# Dev mode auth (legacy/rollback path only; MUST be false in production)
POCKET_DEV_AUTH=

# 首用户 bootstrap 用户名（缺省 admin，仅 DEV_AUTH=true 时生效）
# First user bootstrap username (default admin, only when DEV_AUTH=true)
POCKET_AUTH_USER=

# 首用户 bootstrap 密码（仅 DEV_AUTH=true 时生效；至少 8 字符）
# First user bootstrap password (only when DEV_AUTH=true; minimum 8 chars)
POCKET_AUTH_PASS=

# ----------------------------------------------------------------------------
# AI/STT 后端 / AI/STT Backend (Phase 0)
# ----------------------------------------------------------------------------

# Groq API 密钥（云端 Whisper Large v3 Turbo 兜底）
# Groq API key (cloud Whisper Large v3 Turbo fallback)
POCKET_GROQ_API_KEY=

# kxmemory FastAPI 基础 URL（笔记/分类/SSOT/总结）
# kxmemory FastAPI base URL (notes/categorization/SSOT/summary)
POCKET_KXMEMORY_BASE_URL=

# ----------------------------------------------------------------------------
# 邮箱模块 / Email Module (Phase 0)
# ----------------------------------------------------------------------------

# 邮箱主密钥（AES-GCM 加密 IMAP 凭证，32字节 base64 编码）
# Email master key (AES-GCM encrypt IMAP credentials, 32 bytes base64)
POCKET_EMAIL_MASTER_KEY=

# Google OAuth 客户端 ID / Google OAuth client ID
POCKET_EMAIL_GOOGLE_CLIENT_ID=

# Google OAuth 客户端密钥 / Google OAuth client secret
POCKET_EMAIL_GOOGLE_CLIENT_SECRET=

# Microsoft OAuth 客户端 ID / Microsoft OAuth client ID
POCKET_EMAIL_MICROSOFT_CLIENT_ID=

# Microsoft OAuth 客户端密钥 / Microsoft OAuth client secret
POCKET_EMAIL_MICROSOFT_CLIENT_SECRET=

# OAuth 回调 URL（默认 http://localhost:8088/callback/email/oauth）
# OAuth callback URL (default http://localhost:8088/callback/email/oauth)
POCKET_EMAIL_OAUTH_REDIRECT_URL=

# 是否启用邮件抓取（默认 true；CI/dev 可关闭）
# Enable email fetching (default true; can disable in CI/dev)
POCKET_EMAIL_FETCH_ENABLED=

# ----------------------------------------------------------------------------
# 任务系统整合 / Task System Integration (Phase 5)
# ----------------------------------------------------------------------------

# ACC 系统 MCP 端点 / ACC system MCP endpoint
# 示例：https://mcp.kxpms.cn/acc/mcp
POCKET_MCP_BASE_URL=

# ACC MCP API 密钥（Bearer token）/ ACC MCP API key
POCKET_MCP_API_KEY=

# 跳过 TLS 验证（仅开发/自签证书，生产必须 false）
# Skip TLS verification (dev/self-signed only, MUST be false in production)
POCKET_MCP_INSECURE_TLS=

# ACC JWT — required when POCKET_MCP_BASE_URL is set
POCKET_MCP_TENANT_ID=
POCKET_MCP_SCOPES=tasks,sessions

# 说明：配置以上三项后，pocketd 的 MCP 客户端为双向（internal/mcp/client.go）：
#   读 acc_get_tasks；写 acc_create_task / acc_task_claim / acc_task_complete /
#   acc_report_session（这些 tool 已在 ACC 侧注册）。
# Note: with the above set, the MCP client is bidirectional (read + ACC write tools).

# ----------------------------------------------------------------------------
# 磁盘会话聚合 / Disk Session Aggregation (read-only, Wake-style)
# ----------------------------------------------------------------------------

# 启用后读取本机 agent 落盘的会话转录，注册为只读实例 disk-claude / disk-codex：
#   Claude Code: ~/.claude/projects/**/*.jsonl
#   Codex:       ~/.codex/sessions/**/rollout-*.jsonl + ~/.codex/state_5.sqlite（只读）
# 严格只读：绝不写 agent 数据；未检测到数据目录的 agent 不注册。默认关闭。
# Enable read-only aggregation of on-disk agent transcripts (default off).
POCKET_DISK_SESSIONS_ENABLED=

# 留空 = 注册为运维共享只读实例（所有 workspace 可读、任何租户都不可写）；
# 填 workspace id = 仅该租户可见/可解析。
# Empty = shared read-only operator instances; set a workspace id to scope them.
POCKET_DISK_SESSIONS_WORKSPACE=

# ----------------------------------------------------------------------------
# 龙虾无状态 AI 网关 / Lobster Stateless AI Gateway (Phase C)
# ----------------------------------------------------------------------------

# 嵌入 API 基础 URL（默认 OpenAI）/ Embedding API base URL (default OpenAI)
POCKET_EMBED_BASE_URL=

# 嵌入 API 密钥 / Embedding API key
POCKET_EMBED_API_KEY=
# 或使用 OpenAI API 密钥 / Or use OpenAI API key
POCKET_OPENAI_API_KEY=

# 嵌入模型（默认 text-embedding-3-small）/ Embedding model
POCKET_EMBED_MODEL=text-embedding-3-small

# LLM API 基础 URL（默认 Groq）/ LLM API base URL (default Groq)
# ⚠️ 仅 development：生产环境配置直连（BASE_URL/API_KEY）会触发 PK-3.1
# fail-closed 启动失败——生产请走下方 POCKET_LLM_GATEWAY_* 网关配置。
POCKET_LLM_BASE_URL=

# LLM API 密钥 / LLM API key（⚠️ 仅 development，见上）
POCKET_LLM_API_KEY=
# 如果未设置，回退到 POCKET_GROQ_API_KEY / Falls back to POCKET_GROQ_API_KEY

# 默认 LLM 模型 / Default LLM model
POCKET_LLM_MODEL=

# ----------------------------------------------------------------------------
# 企业网关集成（可选）/ Enterprise Gateway Integration (Optional)
# ----------------------------------------------------------------------------

# llm-gateway-go 企业网关地址 / llm-gateway-go enterprise gateway URL
# 默认 https://llm.kxpms.cn/v1（2026-08-31 切换至此内部门关域；reset 后首次启动会
# 自动 seed 到对应 workspace 的 llm_gateway_configs 行）。
POCKET_LLM_GATEWAY_URL=https://llm.kxpms.cn/v1

# llm-gateway 租户 API 密钥 / llm-gateway tenant API key
POCKET_LLM_GATEWAY_API_KEY=sk-6tGLjzlzUIOuMxh6qhOVRK9eznOTVAkQ3JxRZrvWECrK51YV

# 允许网关运维控制面访问私网/loopback 目标
# Allow the gateway ops control plane to reach private-network / loopback hosts.
#
# 默认关闭。llm-gateway-go 部署在内网时（例如 http://llm-gateway.internal 或
# 10.x/192.168.x）必须显式设为 true，否则 /api/llm-gateway/nodes 的出站请求会被
# SSRF 防护拒绝。
#
# 这是一次有意的安全放宽，只作用于"已注册网关节点"这一条出站路径：
#   - 其它出站校验（如 /api/llm-gateway/config 的 validateOutboundURL）不受影响
#   - 云元数据端点（169.254.169.254 / metadata.google.internal）始终被拦截
#
# 仅在网关确实位于可信内网时开启。
POCKET_LLM_GATEWAY_ALLOW_PRIVATE=false

# OpenCode 实例配置下发令牌 / Bearer token used to push config to OpenCode
#
# 保存 LLM gateway 配置（POST /api/llm-gateway/config）时，Pocket 会把 provider
# 配置推给当前 workspace 名下的 OpenCode 实例，调用其
# PUT /api/config/models + POST /api/config/reload，并以该值作为 Bearer token。
#
# 未设置时的行为：
#   - 当前 workspace 名下没有已注册实例 → 跳过推送，配置照常保存；
#   - 存在已注册实例 → 配置已写入数据库，但推送失败，接口返回 502。
#
# 因此只要使用了边端注册实例（plugin/manager 上报的 registered instance），此项
# 必填，且需与 OpenCode 侧校验的 token 一致。运维共享实例（WorkspaceID 为空）不
# 接收租户配置，不受此项影响。
POCKET_OPENCODE_CONFIG_TOKEN=

# ----------------------------------------------------------------------------
# 审计文件导出（可选，SIEM 对接前过渡）/ Audit File Export (Optional)
# ----------------------------------------------------------------------------
# 说明：这三个变量目前由 cmd/pocketd 直接读取（不经 config.Load/Validate），
# 属已知例外——见 docs/全面优化v1 与 P1 审计交付说明。

# 启用 JSONL 落盘导出的目录（空=禁用）/ Directory enabling JSONL export (empty=off)
AUDIT_EXPORT_DIR=

# 导出轮询间隔（秒，默认 60）/ Export poll interval (seconds, default 60)
AUDIT_EXPORT_INTERVAL=

# 导出文件保留天数（默认 7）/ Retention days for exported files (default 7)
AUDIT_EXPORT_RETENTION_DAYS=
